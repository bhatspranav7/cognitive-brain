# ----- LLM provider: ollama (local) | groq (cloud, free tier) | openai -----
LLM_PROVIDER=ollama

# Ollama (local development)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
# Keep the model in RAM between requests (only the first query pays the load)
OLLAMA_KEEP_ALIVE=30m
# Generation timeout in seconds (CPU inference can be slow; cloud is fast)
LLM_TIMEOUT_SECONDS=600

# Groq (production — get a free key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, ...)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ----- Embeddings: ollama (nomic-embed-text) | local (ONNX MiniLM, no server) -----
EMBEDDING_PROVIDER=ollama

# ----- API -----
# Comma-separated list of allowed browser origins, or * for all
ALLOWED_ORIGINS=*
# Optional shared secret; when set, mutating endpoints need X-API-Key
CORTEX_API_KEY=
# Index documents/ automatically when the vector store is empty
AUTO_INGEST=true
MAX_UPLOAD_MB=25

# ----- Storage (defaults to the repo folder; point at a mounted disk in prod) -----
# DATA_DIR=/var/data
# CHROMA_DIR=/var/data/chroma_db
# DOCS_DIR=/var/data/documents
